{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CSGHUB Values Schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "description": "Global Configuration",
      "properties": {
        "edition": {
          "type": "string",
          "enum": ["ce", "ee", "saas"],
          "description": "Deployment edition"
        },
        "gateway": {
          "type": "object",
          "description": "Gateway configuration",
          "properties": {
            "controllerName": { "type": "string" },
            "service": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["LoadBalancer", "NodePort", "ClusterIP"]
                },
                "nodePorts": {
                  "type": "object",
                  "additionalProperties": { "type": "integer" },
                  "properties": {
                    "http": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "https": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "gitssh": { "type": "integer", "minimum": 1, "maximum": 65535 }
                  }
                }
              }
            },
            "external": {
              "type": "object",
              "properties": {
                "domain": {"type": "string"},
                "public": {"type": "string"},
                "aigateway": {
                  "type": "object",
                  "properties": {
                    "useDomain": {"type": "boolean"},
                    "domain": {"type": "string"}
                  }
                }
              }
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "secretName": {"type": "string"}
              }
            }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "registry": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(:[0-9]+)?$" },
            "registryPolicy": { "type": "string", "enum": ["default", "force"] },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
            "pullSecrets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": {"type": "string"},
            "accessModes": {"type": "array", "items": {"type": "string"}},
            "size": {"type": "string"}
          }
        },
        "postgresql": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "external": {"type": "object", "additionalProperties": true}
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "external": {"type": "object", "additionalProperties": true}
          }
        },
        "objectStore": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "external": {
              "type": "object",
              "properties": {
                "endpoint": {"type": "string"},
                "region": {"type": "string"},
                "accessKey": {"type": "string"},
                "secretKey": {"type": "string"},
                "bucket": {"type": "string"},
                "pathStyle": {"type": "boolean"},
                "secure": {"type": "boolean"},
                "encrypt": {"type": "boolean"}
              }
            }
          }
        },
        "registry": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "external": {
              "type": "object",
              "properties": {
                "registry": {"type": "string"},
                "repository": {"type": "string"},
                "username": {"type": "string"},
                "password": {"type": "string"},
                "insecure": {"type": "boolean"}
              }
            }
          }
        },
        "gitaly": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "external": {"type": "object", "additionalProperties": true}
          }
        },
        "dataflow": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "external": {"type": "object", "additionalProperties": true}
          }
        },
        "chartContext": {
          "type": "object",
          "properties": {
            "isBuiltIn": {"type": "boolean"}
          }
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(:[0-9]+)?$" },
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "logging": {"type": "object", "additionalProperties": true},
    "environments": {"type": "object", "additionalProperties": true},
    "portal": {
      "type": "object",
      "properties": {
        "image": {"type": "object", "additionalProperties": true},
        "gateway": {"type": "object", "additionalProperties": true},
        "docs": {"type": "object", "additionalProperties": true},
        "postgresql": {"type": "object", "additionalProperties": true},
        "objectStore": {
          "type": "object",
          "properties": {
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "accessKey": {"type": "string"},
            "secretKey": {"type": "string"},
            "bucket": {"type": "string"},
            "pathStyle": {"type": "boolean"},
            "secure": {"type": "boolean"},
            "encrypt": {"type": "boolean"}
          }
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "image": { "type": "object", "additionalProperties": true },
        "postgresql": { "type": "object", "additionalProperties": true },
        "redis": { "type": "object", "additionalProperties": true },
        "xnet": { "type": "object", "additionalProperties": true },
        "objectStore": {
          "type": "object",
          "properties": {
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "accessKey": {"type": "string"},
            "secretKey": {"type": "string"},
            "bucket": {"type": "string"},
            "pathStyle": {"type": "boolean"},
            "secure": {"type": "boolean"},
            "encrypt": {"type": "boolean"}
          }
        }
      }
    },
    "rproxy": {
      "type": "object",
      "properties": {
        "coredns": { "type": "object", "additionalProperties": true },
        "nginx": { "type": "object", "additionalProperties": true }
      }
    },
    "notifier": { "type": "object", "additionalProperties": true },
    "payment": { "type": "object", "additionalProperties": true },
    "aigateway": {
      "type": "object",
      "properties": {
        "image": { "type": "object", "additionalProperties": true },
        "service": { "type": "object", "additionalProperties": true },
        "moderation": { "type": "object", "additionalProperties": true },
        "llm": { "type": "object", "additionalProperties": true }
      }
    },
    "xnet": {
      "type": "object",
      "properties": {
        "image": {"type": "object", "additionalProperties": true},
        "service": {"type": "object", "additionalProperties": true},
        "postgresql": {"type": "object", "additionalProperties": true},
        "redis": {"type": "object", "additionalProperties": true},
        "objectStore": {
          "type": "object",
          "properties": {
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "accessKey": {"type": "string"},
            "secretKey": {"type": "string"},
            "bucket": {"type": "string"},
            "pathStyle": {"type": "boolean"},
            "secure": {"type": "boolean"},
            "encrypt": {"type": "boolean"}
          }
        }
      }
    },
    "registry": {
      "type": "object",
      "properties": {
        "objectStore": {
          "type": "object",
          "properties": {
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "accessKey": {"type": "string"},
            "secretKey": {"type": "string"},
            "bucket": {"type": "string"},
            "pathStyle": {"type": "boolean"},
            "secure": {"type": "boolean"},
            "encrypt": {"type": "boolean"}
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "volcano": {"type": "object", "additionalProperties": true},
        "runner": {
          "type": "object",
          "properties": {
            "region": {"type": "string"},
            "interval": { "type": "integer", "minimum": 1 },
            "namespace": {"type": "string"},
            "mergingNamespace": {
              "type": "string",
              "enum": ["multi", "single", "disable"]
            },
            "applicationEndpoint": {"type": "string"},
            "networkInterface": {"type": "string"},
            "storageClassName": {"type": "string"}
          },
          "additionalProperties": true
        },
        "model": {
          "type": "object",
          "properties": {
            "deployTimeoutInMin": {"oneOf": [{"type": "string"}, {"type": "integer"}]},
            "downloadEndpoint": {"type": "string"},
            "dockerRegBase": {"type": "string"},
            "deployStatusCheckInterval": {"oneOf": [{"type": "string"}, {"type": "integer"}]}
          },
          "additionalProperties": true
        },
        "space": {
          "type": "object",
          "properties": {
            "usePublicDomain": {"type": "boolean"},
            "pipIndexUrl": {"type": "string"},
            "deployTimeoutInMin": {"oneOf": [{"type": "string"}, {"type": "integer"}]},
            "buildTimeoutInMin": {"oneOf": [{"type": "string"}, {"type": "integer"}]},
            "gpuModelLabel": {"type": "object", "additionalProperties": true},
            "readinessDelaySeconds": {"oneOf": [{"type": "string"}, {"type": "integer"}]},
            "readinessPeriodSeconds": {"oneOf": [{"type": "string"}, {"type": "integer"}]},
            "readinessFailureThreshold": {"oneOf": [{"type": "string"}, {"type": "integer"}]},
            "statusCheckInterval": {"oneOf": [{"type": "string"}, {"type": "integer"}]}
          },
          "additionalProperties": true
        },
        "knative": {"type": "object", "additionalProperties": true},
        "logcollector": {"type": "object", "additionalProperties": true},
        "gateway": {"type": "object", "additionalProperties": true},
        "reloader": {"type": "object", "additionalProperties": true},
        "prometheus": {"type": "object", "additionalProperties": true}
      }
    }
  },
  "additionalProperties": true
}